<style>
*{box-sizing:border-box}
html,body{
  margin:0;width:100%;height:100%;overflow:hidden;
  background:#020205;color:#00ff9d;
  font-family:Consolas,monospace;
}
canvas{position:fixed;inset:0;z-index:0}

#app{
