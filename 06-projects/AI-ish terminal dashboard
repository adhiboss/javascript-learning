  display:grid;grid-template-columns:250px 1fr;
  backdrop-filter:blur(1px);
}

aside{
  border-right:1px solid #00ff9d44;
  background:#020208cc;
  padding:20px;
  box-shadow:10px 0 50px #00ff9d08;
}

.logo{
  font-size:25px;font-weight:bold;
  letter-spacing:4px;margin-bottom:35px;
  text-shadow:0 0 15px #00ff9d;
}

.logo span{color:#ff00d4}

button{
  width:100%;margin:6px 0;padding:11px;
  background:#00ff9d0a;color:#00ff9d;
  border:1px solid #00ff9d44;
  font-family:inherit;cursor:pointer;
  transition:.2s;
}
button:hover{
  background:#00ff9d22;
  border-color:#00ff9d;
  box-shadow:0 0 20px #00ff9d22;
}

main{padding:18px;overflow:auto}

.top{
  display:flex;justify-content:space-between;
  align-items:center;border-bottom:1px solid #00ff9d33;
  padding-bottom:12px;margin-bottom:15px;
}

.status{
  font-size:12px;
  color:#8affcf;
}

.grid{
  display:grid;
  grid-template-columns:repeat(12,1fr);
  gap:12px;
}

.card{
  background:#03050bcc;
  border:1px solid #00ff9d30;
  padding:15px;
  box-shadow:0 0 30px #00ff9d08;
  position:relative;
  overflow:hidden;
}

.card:before{
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(120deg,transparent,#00ff9d05,transparent);
  animation:scan 4s linear infinite;
}

@keyframes scan{
  from{transform:translateX(-100%)}
  to{transform:translateX(100%)}
}

.big{grid-column:span 8}
.small{grid-column:span 4}
.full{grid-column:1/-1}

h3{
  margin:0 0 12px;
  font-size:12px;
  letter-spacing:2px;
  color:#78ffc9;
}

.metric{
  font-size:38px;
  font-weight:bold;
  text-shadow:0 0 15px currentColor;
}

.green{color:#00ff9d}
.pink{color:#ff00d4}
.blue{color:#00d9ff}

.bar{
  height:7px;background:#ffffff0a;
  margin-top:10px;
}
.bar i{
  display:block;height:100%;
  background:#00ff9d;
  box-shadow:0 0 12px #00ff9d;
}

#terminal{
  height:300px;
  overflow:auto;
  font-size:13px;
  line-height:1.7;
}

.line{white-space:pre-wrap}
.err{color:#ff3864}
