      <div id="game">
        <div id="crosshair"></div>
      </div>
      <div style="margin-top:8px;font-size:12px">
        SCORE: <b id="score">0</b>
        &nbsp; | &nbsp;
        TARGETS: <b id="targets">0</b>
      </div>
    </section>

  </div>
</main>
</div>

<script>

/* =========================
   MATRIX RAIN
========================= */

const canvas=document.getElementById("matrix");
const ctx=canvas.getContext("2d");

let W,H;
let drops=[];

function resize(){
  W=canvas.width=innerWidth;
  H=canvas.height=innerHeight;
  drops=Array(Math.floor(W/16)).fill(1);
}
resize();
addEventListener("resize",resize);

function matrix(){
  ctx.fillStyle="rgba(0,0,0,.08)";
  ctx.fillRect(0,0,W,H);

  ctx.fillStyle="#00ff9d";
  ctx.font="14px monospace";

  drops.forEach((y,i)=>{
    const text="01アイNEURALVOID"[Math.floor(Math.random()*15)];
    ctx.fillText(text,i*16,y*16);

    if(y*16>H && Math.random()>.975) drops[i]=0;
    drops[i]++;
  });

  requestAnimationFrame(matrix);
}
matrix();


/* =========================
   CLOCK
========================= */

function clock(){
  document.getElementById("clock").textContent=
    new Date().toLocaleTimeString()+" // REALITY ONLINE";
}
setInterval(clock,1000);
clock();


/* =========================
   LIVE METRICS
========================= */

setInterval(()=>{
  const cpu=Math.floor(20+Math.random()*75);
  const neural=Math.floor(50+Math.random()*50);

  document.getElementById("cpu").textContent=cpu+"%";
  document.getElementById("cpuBar").style.width=cpu+"%";

  document.getElementById("neural").textContent=neural+"%";
  document.getElementById("neuralBar").style.width=neural+"%";
},900);


/* =========================
   TERMINAL
========================= */

const terminal=document.getElementById("terminal");
const input=document.getElementById("cmd");

function print(text,type=""){
  const d=document.createElement("div");
  d.className="line "+type;
  d.textContent=text;
  terminal.appendChild(d);
  terminal.scrollTop=terminal.scrollHeight;
}

function execute(command){

  command=command.trim().toLowerCase();

  if(!command)return;

  print("root@void:~$ "+command);

  if(command==="help"){
    print(`
AVAILABLE COMMANDS

help       show commands
scan       scan network
hack       breach simulator
decrypt    decrypt core
ghost      enable ghost mode
chaos      unleash chaos
whoami     identify operator
matrix     overload reality
clear      clear terminal
reboot     reboot system
`);
  }

  else if(command==="whoami"){
    print("You are the anomaly.");
  }

  else if(command==="scan"){
    run("scan");
  }

  else if(command==="hack"){
    run("hack");
  }

  else if(command==="decrypt"){
    run("decrypt");
  }

  else if(command==="ghost"){
    run("ghost");
  }

  else if(command==="chaos"){
    run("chaos");
  }

  else if(command==="matrix"){
    for(let i=0;i<30;i++)
      setTimeout(()=>print(
        "REALITY_BUFFER_"+Math.random().toString(36).slice(2)
        +" :: "+Math.random().toString(16).slice(2)
      ),i*50);
  }

  else if(command==="clear"){
    terminal.innerHTML="";
  }

  else if(command==="reboot"){
    print("REBOOTING...");
    setTimeout(()=>location.reload(),1200);
  }

  else{
    print("Command not found. Reality disagrees.","err");
  }
}

input.addEventListener("keydown",e=>{
  if(e.key==="Enter"){
    execute(input.value);
    input.value="";
  }
});


/* =========================
   CRAZY COMMANDS
========================= */

function run(type){

  if(type==="clear"){
    terminal.innerHTML="";
    return;
  }

  if(type==="scan"){
    print("Scanning dimensional network...","info");

    let hosts=[
      "192.168.0.13",
      "10.0.7.44",
      "VOID://UNKNOWN",
      "NEURAL://CORE",
      "127.0.0.1"
    ];

    hosts.forEach((h,i)=>{
      setTimeout(()=>{
        print(
          "[+] "+h+
          " :: PORTS "+
          Math.floor(100+Math.random()*900)+
          " :: "+(Math.random()>.5?"OPEN":"FILTERED")
        );
      },i*350);
    });
  }

  if(type==="hack"){
    print("Initializing simulated breach...","info");

    let p=0;

    const timer=setInterval(()=>{
      p+=Math.floor(Math.random()*15)+5;

      if(p>=100){
        p=100;
        clearInterval(timer);
        print("ACCESS GRANTED // SIMULATION COMPLETE");
        document.getElementById("threat").textContent="MAXIMUM";
      }

      print("Bypassing firewall ["+"█".repeat(p/5)+"] "+p+"%");
    },180);
  }

  if(type==="decrypt"){
    print("Decrypting quantum core...");

    const secret=[
      "THE",
      "VOID",
      "IS",
      "LOOKING",
      "BACK"
    ];

    secret.forEach((x,i)=>{
      setTimeout(()=>{
        print("KEY "+(i+1)+" >> "+x);
      },i*500);
    });

    setTimeout(()=>{
      print("MESSAGE DECRYPTED: YOU WERE NEVER ALONE.","info");
    },2800);
  }

  if(type==="ghost"){
    document.body.style.filter=
      document.body.style.filter?
      "":
      "hue-rotate(120deg) contrast(1.3)";
    print("GHOST MODE TOGGLED.");
  }

  if(type==="chaos"){
    document.body.animate([
      {transform:"translate(0,0)"},
      {transform:"translate(8px,-5px)"},
      {transform:"translate(-8px,5px)"},
      {transform:"translate(0,0)"}
    ],{duration:500,iterations:8});

    for(let i=0;i<100;i++){
      setTimeout(()=>{
        spawnEnemy(
          Math.random()*innerWidth,
          Math.random()*innerHeight
        );
      },i*20);
    }

    print("CHAOS PROTOCOL ACTIVATED.","err");
  }
}


/* =========================
   EVENT STREAM
========================= */

const events=[
  "Quantum packet intercepted",
  "Unknown node connected",
  "Firewall regenerated",
  "Neural pulse detected",
  "Ghost process spawned",
  "Reality checksum changed",
  "Encrypted signal received",
  "Observer detected"
];

setInterval(()=>{
  const d=document.createElement("div");
  d.textContent=
    "["+new Date().toLocaleTimeString()+"] "+
    events[Math.floor(Math.random()*events.length)];

  document.getElementById("logs").prepend(d);

  if(document.getElementById("logs").children.length>12)
    document.getElementById("logs").lastChild.remove();
},700);


/* =========================
   MINI GAME
========================= */

const game=document.getElementById("game");
const cross=document.getElementById("crosshair");

let score=0;
let targetCount=0;

game.addEventListener("mousemove",e=>{
  const r=game.getBoundingClientRect();

  cross.style.left=(e.clientX-r.left-15)+"px";
  cross.style.top=(e.clientY-r.top-15)+"px";
});

function spawnEnemy(x,y){

  const e=document.createElement("div");
  e.className="enemy";

  const r=game.getBoundingClientRect();

  e.style.left=Math.max(0,Math.min(r.width-20,x-r.left))+"px";
  e.style.top=Math.max(0,Math.min(r.height-20,y-r.top))+"px";

  game.appendChild(e);

  targetCount++;
  document.getElementById("targets").textContent=targetCount;

  const life=setTimeout(()=>{
    if(e.parentNode){
      e.remove();
      targetCount--;
      document.getElementById("targets").textContent=targetCount;
    }
  },3000);

  e.onclick=ev=>{
    ev.stopPropagation();
    clearTimeout(life);
    e.remove();

    score++;
    targetCount--;

    document.getElementById("score").textContent=score;
    document.getElementById("targets").textContent=targetCount;

    beep();
  };
}

setInterval(()=>{
  const r=game.getBoundingClientRect();
  spawnEnemy(
    r.left+Math.random()*r.width,
    r.top+Math.random()*r.height
  );
},1200);


/* =========================
   SOUND ENGINE
========================= */

let sound=false;
let audio;

function toggleSound(){
  sound=!sound;
  document.getElementById("sound").textContent=
    sound?"ON":"OFF";

  if(sound) beep();
}

function beep(){

  if(!sound)return;

  audio=audio||new AudioContext();

  const osc=audio.createOscillator();
  const gain=audio.createGain();

  osc.frequency.value=500+Math.random()*500;
  gain.gain.value=.025;

  osc.connect(gain);
  gain.connect(audio.destination);

  osc.start();
  osc.stop(audio.currentTime+.06);
}


/* =========================
   RANDOM SYSTEM MESSAGES
========================= */

setInterval(()=>{

  const messages=[
    "WATCHER PROCESS ACTIVE",
    "NOISE IN SECTOR 7",
    "MEMORY FRAGMENT FOUND",
    "UNKNOWN SIGNAL",
    "TIME DRIFT +0.002ms",
    "AI CORE OBSERVING",
    "SIMULATION STABLE"
  ];

  if(Math.random()>.5)
    print(
      "[SYSTEM] "+
      messages[Math.floor(Math.random()*messages.length)]
    );

},5000);

</script>

</body>
</html>
