  <div class="grid">

    <section class="card small">
      <h3>CPU LOAD</h3>
      <div class="metric green" id="cpu">42%</div>
      <div class="bar"><i id="cpuBar" style="width:42%"></i></div>
    </section>

    <section class="card small">
      <h3>NEURAL ACTIVITY</h3>
      <div class="metric pink" id="neural">87%</div>
      <div class="bar"><i id="neuralBar" style="width:87%;background:#ff00d4"></i></div>
    </section>

    <section class="card small">
      <h3>VOID ENERGY</h3>
      <div class="metric blue" id="energy">∞</div>
      <div class="bar"><i style="width:100%;background:#00d9ff"></i></div>
    </section>

    <section class="card big">
      <h3>QUANTUM TERMINAL</h3>

      <div id="terminal">
        <div class="line info">NEURAL//VOID boot sequence initiated...</div>
        <div class="line">Loading quantum modules ████████████ 100%</div>
        <div class="line">Reality engine: ONLINE</div>
        <div class="line">Human interface: ACCEPTED</div>
        <div class="line">Type "help" for available commands.</div>
      </div>

      <div class="input">
        <span>root@void:~$</span>
        <input id="cmd" autocomplete="off" autofocus>
      </div>
    </section>

    <section class="card small">
      <h3>LIVE EVENT STREAM</h3>
      <div class="logs" id="logs"></div>
